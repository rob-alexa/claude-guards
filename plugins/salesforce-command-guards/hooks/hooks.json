{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "p=python3; case \"$OSTYPE\" in msys*|cygwin*) p=python ;; esac; exec \"$p\" \"${CLAUDE_PLUGIN_ROOT}/hooks/pretool-guards.py\"",
            "timeout": 30,
            "statusMessage": "Running the Salesforce command guards..."
          }
        ]
      }
    ]
  }
}
